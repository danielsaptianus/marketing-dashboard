# Application
NODE_ENV=development
PORT=3000
APP_NAME=marketing-dashboard

# External Services
AUTH_SERVICE_URL=https://auth-service.urbansolv.co.id
HR_SERVICE_URL=https://hr-service.urbansolv.co.id/api/v1/external
X_API_KEY=sk-marketing-dev-key-change-in-production

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/marketing_monitoring_db?schema=public"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_PUBLIC_KEY_BASE64=your-base64-encoded-public-key
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=30d

# CORS
CORS_ORIGIN=http://localhost:3001

# API
API_PREFIX=api

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs
